{
	"name": "editorium",
	"version": "0.1.0",
	"description": "Editorium — an AI photo editor on Cloudflare Workers",
	"license": "GPL-3.0-only",
	"author": "Ali Ahad",
	"homepage": "https://editorium.aliahad.workers.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aliahadmd/editorium.git"
	},
	"private": true,
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=22.22.0",
		"pnpm": ">=11.5.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@hookform/resolvers": "^5.4.0",
		"@tailwindcss/vite": "^4.3.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.30",
		"lucide-react": "^1.24.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.81.0",
		"react-router": "^8.3.0",
		"shadcn": "^4.13.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.45.1",
		"@cloudflare/vitest-pool-workers": "0.18.6",
		"@eslint/js": "9.39.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"drizzle-kit": "0.31.10",
		"esbuild": "0.25.12",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"jsdom": "^29.1.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.10",
		"wrangler": "4.112.0"
	},
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "pnpm run db:check && pnpm run lint && pnpm run test && pnpm run build && wrangler deploy --dry-run",
		"db:check": "drizzle-kit check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"deploy": "pnpm run db:migrate:remote && wrangler deploy",
		"dev": "vite",
		"lint": "eslint . --max-warnings 0",
		"preview": "pnpm run build && vite preview",
		"test": "pnpm run test:app && pnpm run test:worker",
		"test:app": "vitest run --config vitest.app.config.ts",
		"test:worker": "vitest run --config vitest.worker.config.ts",
		"typecheck": "tsc -b",
		"probe:models": "esbuild scripts/probe-models.ts --bundle --platform=node --format=esm --packages=external --tsconfig-raw={} --outfile=.probe/probe-models.mjs --log-level=warning && node .probe/probe-models.mjs"
	},
	"type": "module"
}
