/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "editorium",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-07-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "editorium-db",
			"database_id": "5c05fada-080e-4f7e-a301-592264245d95",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "editorium-media"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"images": {
		"binding": "IMAGES"
	},
	"queues": {
		"producers": [
			{
				"binding": "AI_JOBS",
				"queue": "editorium-ai-jobs"
			}
		],
		"consumers": [
			{
				"queue": "editorium-ai-jobs",
				"max_batch_size": 1,
				"max_retries": 3,
				"max_batch_timeout": 5
			}
		]
	},
	"workflows": [
		{
			"name": "editorium-segment",
			"binding": "SEGMENT_WORKFLOW",
			"class_name": "SegmentWorkflow"
		}
	],
	/**
	 * Per-location, eventually consistent limiters (first line of defence);
	 * the D1 job-count check in lib/limits.ts is the exact backstop.
	 */
	"ratelimits": [
		{
			// AI-cost routes, keyed by user id.
			"name": "AI_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			// Anonymous auth routes (guest creation, owner claim), keyed by client IP.
			"name": "AUTH_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	/**
	 * Never put secrets in `vars`. Set them with `wrangler secret put` (prod)
	 * or `.dev.vars` (local). Deploy fails if either is missing.
	 */
	"secrets": {
		"required": ["AUTH_SECRET", "OWNER_CLAIM_KEY"]
	},
	"vars": {
		/**
		 * Production runs the real Workers AI models below. Tests override this
		 * to "true" (vitest.worker.config.ts) so they never spend AI usage.
		 */
		"AI_MOCK": "false",
		/** The pre-auth demo account; reclaimed via POST /api/auth/claim. */
		"OWNER_USER_ID": "1fbf74ad-5db9-4996-a744-0bc17ce30ad6",
		"MODEL_EDIT_PRIMARY": "pruna/p-image-edit",
		"MODEL_DETECT_MOONDREAM": "@cf/moondream/moondream3.1-9B-A2B",
		"MODEL_VLM": "@cf/meta/llama-3.2-11b-vision-instruct",
		"MODEL_VLM_SECONDARY": "@cf/zai-org/glm-5.3-flash",
		"MODEL_EDIT": "@cf/black-forest-labs/flux-2-klein-9b",
		"MODEL_T2I": "@cf/black-forest-labs/flux-1-schnell",
		"MODEL_IMG2IMG": "@cf/bytedance/stable-diffusion-xl-lightning",
		"MODEL_LLM": "@cf/zai-org/glm-5.3-flash"
	}
}
